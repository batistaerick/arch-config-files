#!/usr/bin/env bash
set -euo pipefail
for role in AUTHOR COMMITTER; do
  identity="$(git var "GIT_${role}_IDENT")"
  if [[ "$identity" != *'<batista.erick@outlook.com>'* ]]; then
    printf 'Eitr is a personal repo. Refusing %s identity: %s\nUse batistaerick / batista.erick@outlook.com; never the work account.\n' "$role" "$identity" >&2
    exit 1
  fi
done
