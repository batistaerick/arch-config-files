#!/usr/bin/env bash
set -euo pipefail
if [[ "${2:-}" != 'git@github-personal:batistaerick/eitr.git' ]]; then
  printf 'Eitr pushes must use the personal SSH remote: git@github-personal:batistaerick/eitr.git\n' >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" != 0000000000000000000000000000000000000000 ]] || continue
  if git log "$local_oid" --format='%ae%n%ce' | rg -Fx 'erick@doola.com' >/dev/null; then
    printf 'Refusing to push Eitr history containing the work identity.\n' >&2
    exit 1
  fi
done
