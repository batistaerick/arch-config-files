#!/usr/bin/env bash
set -euo pipefail
if [[ "${2:-}" != 'git@github-personal:batistaerick/eitr.git' ]]; then
  printf 'Eitr pushes must use the personal SSH remote: git@github-personal:batistaerick/eitr.git\n' >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" != 0000000000000000000000000000000000000000 ]] || continue
  # Captured first: grep -q exiting early would SIGPIPE git log under pipefail.
  identities="$(git log "$local_oid" --format='%an%n%ae%n%cn%n%ce')"
  if grep -Eiq -- '@doola\.com$|erickdoola' <<< "$identities"; then
    printf 'Refusing to push Eitr history containing a work identity (%s).\n' "$local_ref" >&2
    exit 1
  fi
done
