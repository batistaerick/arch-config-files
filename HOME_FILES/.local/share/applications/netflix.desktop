[Desktop Entry]
Type=Application
Name=Netflix
Comment=Netflix in a dedicated Chrome window
Exec=sh -c "exec \"\$HOME/.local/bin/netflix\""
TryExec=google-chrome-stable
Icon=netflix
Terminal=false
Categories=AudioVideo;Video;
StartupWMClass=Netflix
Actions=Software;

[Desktop Action Software]
Name=Netflix (Software Rendering)
Exec=sh -c "exec \"\$HOME/.local/bin/netflix\" software"
