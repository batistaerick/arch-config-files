# Fresh-install development defaults, based on the current working setup.
# Override with DISTRO_* environment variables; no account state is copied.
DISTRO_NVM_VERSION=${DISTRO_NVM_VERSION:-v0.40.8}
DISTRO_NODE_VERSION=${DISTRO_NODE_VERSION:-24.15.0}
DISTRO_JAVA_VERSION=${DISTRO_JAVA_VERSION:-25.0.3-oracle}
DISTRO_MAVEN_VERSION=${DISTRO_MAVEN_VERSION:-3.9.2}
DISTRO_PNPM_VERSION=${DISTRO_PNPM_VERSION:-10.33.2}
DISTRO_YARN_VERSION=${DISTRO_YARN_VERSION:-1.22.22}
