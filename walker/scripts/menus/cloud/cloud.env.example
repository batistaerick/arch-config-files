# Machine-local settings for the Walker cloud menus.
# Copy to ~/.config/eitr/cloud.env (not tracked by git) and edit.

# AWS profiles shown in the AWS and Grafana menus, as Label=profile pairs
# separated by spaces. When unset, every `aws configure list-profiles` entry
# is listed by its own name.
#EITR_AWS_PROFILES="Development=my-dev Production=my-prod"

# Default AWS region. When unset, each profile's configured region is used.
#EITR_AWS_REGION="us-east-1"
