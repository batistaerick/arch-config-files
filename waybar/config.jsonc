{
  "height": 30,
  "spacing": 1,
  "output": "HDMI-A-1",
  "position": "top",
  "modules-left": [
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
  ],
  "modules-center": [],
  "modules-right": [
    "custom/gpu",
    "custom/cpu",
    "custom/memory",
    "battery",
    "custom/wifi",
    "bluetooth",
    "pulseaudio",
    "pulseaudio#mic",
    "custom/status-toggle",
    "custom/notifications",
    "clock",
  ],
  "custom/status-toggle": {
    "exec": "$HOME/.config/waybar/scripts/status-toggle.sh state",
    "return-type": "json",
    "interval": 3600,
    "signal": 8,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/status-toggle.sh toggle",
    "cursor": true,
  },
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/hypr-workspace.py status 1",
    "return-type": "json",
    "restart-interval": 2,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
    "cursor": true,
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/hypr-workspace.py status 2",
    "return-type": "json",
    "restart-interval": 2,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
    "cursor": true,
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/hypr-workspace.py status 3",
    "return-type": "json",
    "restart-interval": 2,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
    "cursor": true,
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/hypr-workspace.py status 4",
    "return-type": "json",
    "restart-interval": 2,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
    "cursor": true,
  },
  "clock": {
    "format": "{:%a %b %d %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh dev.local.CalendarPanel $HOME/.config/waybar/scripts/calendar-panel.py",
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu-status.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh system-monitor kitty --class system-monitor -e btop",
  },
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory-status.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh system-monitor kitty --class system-monitor -e btop",
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu-usage.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "escape": false,
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh system-monitor kitty --class system-monitor -e btop",
  },
  "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi-status.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh setup-wifi kitty --class setup-wifi -e impala",
  },
  "battery": {
    "interval": 10,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime: {time}",
  },
  "network": {
    "tooltip": true,
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤥"],
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": " ",
    "format-ethernet": "󰈀 ",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh setup-wifi kitty --class setup-wifi -e impala",
    "rotate": 0,
    "interval": 2,
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh blueman-manager blueman-manager",
  },
  "pulseaudio": {
    "tooltip": true,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", " "] },
    "tooltip-format": "{volume}%",
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh org.pulseaudio.pavucontrol pavucontrol",
  },
  "pulseaudio#mic": {
    "backend": "pipewire",
    "tooltip": true,
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip-format": "{source_volume}%",
    "on-click": "$HOME/.config/waybar/scripts/open-panel.sh org.pulseaudio.pavucontrol pavucontrol",
  },
  "custom/notifications": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
