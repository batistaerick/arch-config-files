{
  "height": 31,
  "spacing": 1,
  "output": "HDMI-A-1",
  "position": "top",
  "modules-left": [
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5",
    "custom/ws6",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "battery",
    "network",
    "bluetooth",
    "pulseaudio",
    "pulseaudio#mic",
    "custom/notifications",
  ],
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/workspace.sh 1",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
    "cursor": true,
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/workspace.sh 2",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
    "cursor": true,
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/workspace.sh 3",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
    "cursor": true,
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/workspace.sh 4",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
    "cursor": true,
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/workspace.sh 5",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
    "cursor": true,
  },
  "custom/ws6": {
    "exec": "~/.config/waybar/scripts/workspace.sh 6",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
    "cursor": true,
  },
  "clock": {
    "format": "{:%a %b %d %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "on-click": "gnome-calendar",
  },
  "battery": {
    "interval": 10,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime: {time}",
  },
  "network": {
    "tooltip": true,
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤥"],
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": " ",
    "format-ethernet": "󰈀 ",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e impala",
    "rotate": 0,
    "interval": 2,
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "pulseaudio": {
    "tooltip": true,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", " "] },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol",
  },
  "pulseaudio#mic": {
    "backend": "pipewire",
    "tooltip": true,
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip-format": "{source_volume}%",
    "on-click": "pavucontrol",
  },
  "custom/notifications": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
